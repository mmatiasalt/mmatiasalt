import xml.etree.ElementTree as ET
import os

def extract_medications_administered_csv(filepath):
    """
    Extracts the codesystem displayName for each individual entry under the
    "Medications Administered" section of an HL7 CDA document, including
    effectiveTime low and high values, and prints the results in CSV format.
    """

    if not os.path.exists(filepath):
        print(f"Error: File '{filepath}' not found.")
        return

    try:
        tree = ET.parse(filepath)
        root = tree.getroot()
    except ET.ParseError as e:
        print(f"Error parsing XML: {e}")
        return

    namespaces = {'cda': 'urn:hl7-org:v3', 'xsi': 'http://www.w3.org/2001/XMLSchema-instance'}

    medications_section = None
    for section in root.findall(".//cda:section", namespaces):
        for template_id in section.findall("./cda:templateId", namespaces):
            if template_id.get('root') == '2.16.840.1.113883.10.20.22.2.38':
                medications_section = section
                break
        if medications_section is not None:
            break

    if medications_section is None:
        print("Medications Administered section not found.")
        return

    entries = medications_section.findall(".//cda:entry[@typeCode='DRIV']/cda:substanceAdministration", namespaces)

    print("Medication Name,Effective Time Low,Effective Time High")  # Header row
    for entry in entries:
        effective_time = entry.find("./cda:effectiveTime", namespaces)
        if effective_time is not None and effective_time.get('{http://www.w3.org/2001/XMLSchema-instance}type') == 'IVL_TS':
            low_value = effective_time.find("./cda:low", namespaces).get('value') if effective_time.find("./cda:low", namespaces) is not None else "N/A"
            high_value = effective_time.find("./cda:high", namespaces).get('value') if effective_time.find("./cda:high", namespaces) is not None else effective_time.find("./cda:high", namespaces).get('nullFlavor') if effective_time.find("./cda:high", namespaces) is not None else "N/A"

            consumable = entry.find("./cda:consumable/cda:manufacturedProduct/cda:manufacturedMaterial/cda:code", namespaces)
            if consumable is not None and consumable.get('displayName'):
                display_name = consumable.get('displayName')
                print(f'"{display_name}",{low_value},{high_value}')  # CSV row

