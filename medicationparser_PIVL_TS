import xml.etree.ElementTree as ET
import io

def extract_medications_administered_csv(xml_file_path):
    """
    Extracts medication data from an XML file and prints it in CSV format.
    Handles both IVL_TS and PIVL_TS effectiveTime types.
    """

    try:
        tree = ET.parse(xml_file_path)
        root = tree.getroot()
    except ET.ParseError as e:
        print(f"Error parsing XML: {e}")
        return

    namespaces = {'cda': 'urn:hl7-org:v3', 'xsi': 'http://www.w3.org/2001/XMLSchema-instance'}

    medications_section = None
    for section in root.findall(".//cda:section", namespaces):
        for template_id in section.findall("./cda:templateId", namespaces):
            if template_id.get('root') == '2.16.840.1.113883.10.20.22.2.38':
                medications_section = section
                break
        if medications_section is not None:
            break

    if medications_section is None:
        print("Medications Administered section not found.")
        return

    entries = medications_section.findall(".//cda:entry[@typeCode='DRIV']/cda:substanceAdministration", namespaces)

    print("Medication Name,Effective Time,Period Unit, Period Value")  # Header row
    for entry in entries:
        effective_time = entry.find("./cda:effectiveTime", namespaces)
        display_name = "N/A"
        if effective_time is not None:
            if effective_time.get('{http://www.w3.org/2001/XMLSchema-instance}type') == 'PIVL_TS':
                effective_value = effective_time.get('value')
                period_unit = effective_time.find("./cda:period", namespaces).get('unit') if effective_time.find("./cda:period", namespaces) is not None else "N/A"
                period_value = effective_time.find("./cda:period", namespaces).get('value') if effective_time.find("./cda:period", namespaces) is not None else "N/A"
            elif effective_time.get('value'):
                effective_value = effective_time.get('value')
                period_unit = "N/A"
                period_value = "N/A"
            else:
                effective_value = "N/A"
                period_unit = "N/A"
                period_value = "N/A"

            consumable = entry.find("./cda:consumable/cda:manufacturedProduct/cda:manufacturedMaterial/cda:code", namespaces)
            if consumable is not None and consumable.get('displayName'):
                display_name = consumable.get('displayName')
            print(f'"{display_name}",{effective_value},{period_unit},{period_value}')  # CSV row

